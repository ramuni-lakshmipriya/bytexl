# JWT Secret for Session Cookies
JWT_SECRET=gencraft_secret_key_hackathon_2026

# Server Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Gemini LLM API Key (Optional - Rule-based fallback active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth2 Credentials
# Developer Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth2 Credentials
# Meta for Developers: https://developers.facebook.com/
# Valid OAuth Redirect URI: {BACKEND_URL}/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram OAuth2 Credentials (Professional / Test Mode)
# Meta for Developers: https://developers.facebook.com/
# Valid OAuth Redirect URI: {BACKEND_URL}/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
